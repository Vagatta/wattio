# Variables en BUILD (no van al servidor; solo se usan al ejecutar npm run build)

# Dominio público en producción: alimenta canonical, Open Graph, sitemap y robots.txt
PUBLIC_SITE_URL=https://tu-dominio.com

# Analítica alternativa opcional, cargada solo tras aceptar en el aviso de cookies.
# Con Plausible basta el dominio; PUBLIC_ANALYTICS_SCRIPT apunta a otra instancia compatible.
PUBLIC_ANALYTICS_DOMAIN=
PUBLIC_ANALYTICS_SCRIPT=

# Los secretos de envío (Resend) NO van aquí: en producción viven en
# wattio-secrets.php, fuera del webroot. Ver deploy/wattio-secrets.example.php.
