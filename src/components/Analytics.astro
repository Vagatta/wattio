---
// Analítica sin cookies.
// Cloudflare Web Analytics: activa solo en builds de producción (el dev local no ensucia métricas).
// El token es público por diseño: cualquier visitante lo ve en el HTML, como en todas las webs que lo usan.
// Alternativa: PUBLIC_ANALYTICS_DOMAIN activa Plausible/compatible; PUBLIC_ANALYTICS_SCRIPT apunta a otra instancia.
const cfToken = 'bcb7b61451f34b6f9e9e97c5d1cddaa2';
const domain = import.meta.env.PUBLIC_ANALYTICS_DOMAIN;
const scriptSrc = import.meta.env.PUBLIC_ANALYTICS_SCRIPT ?? 'https://plausible.io/js/script.js';
---
{import.meta.env.PROD ? <script define:vars={{ cfToken }}>
  window.addEventListener('load', () => {
    const s = document.createElement('script');
    s.type = 'module';
    s.src = 'https://static.cloudflareinsights.com/beacon.min.js';
    s.dataset.cfBeacon = JSON.stringify({ token: cfToken });
    document.head.appendChild(s);
  });
</script> : null}
{domain ? <script defer data-domain={domain} src={scriptSrc} /> : null}
