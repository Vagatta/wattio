---
import '@fontsource-variable/manrope';
import Icon from '../components/Icon.astro';
import '../styles/wattio.css';

interface Props {
  title: string;
  description: string;
  noindex?: boolean;
}
const { title, description, noindex = false } = Astro.props;

const siteUrl = Astro.site ?? new URL('https://wattio.es');
const canonicalUrl = new URL(Astro.url.pathname, siteUrl);
---
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#180e2c" />
    <meta name="description" content={description} />
    <meta name="robots" content={noindex ? 'noindex, follow' : 'index, follow'} />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" sizes="any" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <title>{title}</title>
  </head>
  <body>
    <a href="#top" class="skip-link">Saltar al contenido</a>
    <header class="nav-wrap">
      <a class="brand" href="/" aria-label="Wattio, inicio"><span class="brand-mark"><Icon name="bolt" size={23} /></span><span translate="no">wattio</span></a>
      <nav aria-label="Navegación principal"><a class="nav-cta" href="/#revisar">Revisar mi factura<Icon name="arrow" size={18} /></a></nav>
    </header>
    <main id="top" class="legal container" tabindex="-1">
      <slot />
    </main>
    <footer class="footer container">
      <div class="footer-bottom">
        <span>© {new Date().getFullYear()} Wattio</span>
        <a href="/">Volver a la portada</a>
        <a href="/privacidad">Privacidad</a>
        <a href="/aviso-legal">Aviso legal</a>
      </div>
    </footer>
  </body>
</html>
