---
import Legal from '../layouts/Legal.astro';
import Icon from '../components/Icon.astro';
---
<Legal
  title="Página no encontrada — Wattio"
  description="La página que buscas no existe. Vuelve a la portada de Wattio para revisar tu factura de luz."
  noindex
>
  <article class="legal-content not-found">
    <p class="legal-kicker">Error 404</p>
    <h1>Esta página se ha fundido.</h1>
    <p class="not-found-text">La dirección que buscas no existe o se ha movido. Lo importante sigue en la portada.</p>
    <a class="button primary" href="/">Volver a Wattio<Icon name="arrow" size={20} /></a>
  </article>
</Legal>
