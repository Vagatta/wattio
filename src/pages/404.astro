---
import Page from '../layouts/Page.astro';
import Icon from '../components/Icon.astro';
---
<Page
  title="Página no encontrada — Wattios"
  description="La página que buscas no existe. Vuelve a la portada de Wattios para revisar tu factura de luz o gas."
  noindex
>
  <article class="legal-content not-found">
    <p class="legal-kicker">Error 404</p>
    <h1>Esta página se ha fundido.</h1>
    <p class="not-found-text">La dirección que buscas no existe o se ha movido. Lo importante sigue en la portada.</p>
    <a class="button primary" href="/">Volver a Wattios<Icon name="arrow" size={20} /></a>
  </article>
</Page>
