---
import '@fontsource-variable/manrope';
import Analytics from '../components/Analytics.astro';
import Icon from '../components/Icon.astro';
import InvoiceExplorer from '../components/InvoiceExplorer.astro';
import '../styles/wattio.css';

const whatsappNumber = '34646583077';
const whatsappMessage = 'Hola, Wattio. Quiero revisar mi factura de luz o gas.';
const whatsappUrl = `https://wa.me/${whatsappNumber}?text=${encodeURIComponent(whatsappMessage)}`;

const siteUrl = Astro.site ?? new URL('https://wattio.es');
const canonicalUrl = new URL(Astro.url.pathname, siteUrl);
const ogImageUrl = new URL('/og-image.png', siteUrl);
const pageTitle = 'Wattio — Revisa tus facturas de luz y gas y paga solo lo justo';
const pageDescription = 'Envía tu factura de luz o gas a Wattio y entiende qué pagas: consumo, potencia y extras revisados con claridad. Tú decides el siguiente paso.';

const faqs = [
  { question: '¿Qué parte de la factura se revisa?', answer: 'El precio de la energía, la potencia contratada y los servicios adicionales, tanto en la factura de luz como en la de gas. El objetivo es entender qué pagas y qué opciones encajan con tu consumo.' },
  { question: '¿Me garantiza Wattio que voy a ahorrar?', answer: 'No. El ahorro depende de tu tarifa, de tu consumo y de las alternativas disponibles. Si tu situación ya es buena, una revisión también puede ayudarte a confirmarlo.' },
  { question: '¿Tengo que cambiar de compañía?', answer: 'No. Conocer otras opciones no implica contratar nada. Cualquier cambio debe ser una decisión tuya, después de conocer sus condiciones.' },
  { question: '¿Qué ocurre cuando selecciono una factura?', answer: 'Nada hasta que tú confirmes. Los archivos se quedan en tu dispositivo y solo se envían a Wattio por email cuando pulsas «Enviar factura a Wattio».' },
  { question: '¿Puedo enviarla por WhatsApp?', answer: 'Sí. Pulsa «Enviar por WhatsApp» para abrir el chat con Wattio en el +34 646 58 30 77. Adjunta la foto o el PDF y envía el mensaje desde WhatsApp. El archivo que selecciones en esta web no se transfiere al chat automáticamente.' },
];
const steps = [
  { number: '1', icon: 'document' as const, title: 'Tu factura, tal cual.', text: 'Una foto legible o un PDF. No necesitas copiar números ni entender cada concepto.' },
  { number: '2', icon: 'bolt' as const, title: 'Le damos una vuelta.', text: 'Consumo, potencia y extras. Una revisión que mire más allá del importe final.' },
  { number: '3', icon: 'check' as const, title: 'Tú tienes la última palabra.', text: 'Entiende tus opciones antes de decidir. Sin dar por hecho que debas cambiar.' },
];

const organizationId = `${siteUrl.origin}/#organization`;
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      '@id': organizationId,
      name: 'Wattio',
      url: `${siteUrl.origin}/`,
      logo: { '@type': 'ImageObject', url: new URL('/icon-512.png', siteUrl).href },
      contactPoint: {
        '@type': 'ContactPoint',
        contactType: 'customer service',
        telephone: '+34 646 58 30 77',
        availableLanguage: 'es',
      },
    },
    {
      '@type': 'WebSite',
      '@id': `${siteUrl.origin}/#website`,
      url: `${siteUrl.origin}/`,
      name: 'Wattio',
      inLanguage: 'es',
      publisher: { '@id': organizationId },
    },
    {
      '@type': 'WebPage',
      '@id': `${canonicalUrl.href}#webpage`,
      url: canonicalUrl.href,
      name: pageTitle,
      description: pageDescription,
      inLanguage: 'es',
      isPartOf: { '@id': `${siteUrl.origin}/#website` },
      about: { '@id': organizationId },
    },
    {
      '@type': 'Service',
      name: 'Revisión de facturas de luz y gas',
      serviceType: 'Revisión de factura de luz o gas',
      description: 'Revisión de la factura de luz o gas para entender el consumo, la potencia contratada y los servicios adicionales antes de decidir.',
      provider: { '@id': organizationId },
      areaServed: { '@type': 'Country', name: 'España' },
      availableChannel: { '@type': 'ServiceChannel', serviceUrl: whatsappUrl },
    },
    {
      '@type': 'FAQPage',
      mainEntity: faqs.map(faq => ({
        '@type': 'Question',
        name: faq.question,
        acceptedAnswer: { '@type': 'Answer', text: faq.answer },
      })),
    },
  ],
};
---

<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#180e2c" />
    <meta name="description" content={pageDescription} />
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1" />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="alternate" hreflang="es" href={canonicalUrl} />
    <link rel="alternate" hreflang="x-default" href={canonicalUrl} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_ES" />
    <meta property="og:site_name" content="Wattio" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Wattio — revisión de tus facturas de luz y gas" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDescription} />
    <meta name="twitter:image" content={ogImageUrl} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" sizes="any" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <title>{pageTitle}</title>
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    <Analytics />
  </head>
  <body>
    <a href="#top" class="skip-link">Saltar al contenido</a>
    <header class="nav-wrap">
      <a class="brand" href="#top" aria-label="Wattio, inicio"><span class="brand-mark"><Icon name="bolt" size={23} /></span><span translate="no">wattio</span></a>
      <nav class="desktop-nav" aria-label="Navegación principal"><a href="#como-funciona">Cómo funciona</a><a href="#faq">Preguntas frecuentes</a></nav>
      <div class="nav-actions">
        <a class="nav-cta" href="#revisar">Revisar mi factura<Icon name="arrow" size={18} /></a>
        <button class="menu-toggle" type="button" aria-label="Menú" aria-expanded="false" aria-controls="mobile-navigation"><Icon name="menu" size={20} /></button>
      </div>
      <nav id="mobile-navigation" class="mobile-nav" aria-label="Navegación móvil" hidden><a href="#como-funciona">Cómo funciona</a><a href="#faq">Preguntas frecuentes</a><a href="#revisar">Revisar mi factura</a></nav>
    </header>

    <main id="top" tabindex="-1">
      <section class="hero container" id="revisar" aria-labelledby="hero-heading" data-supply="luz">
        <div class="hero-copy">
          <h1 id="hero-heading">Sube tu factura de luz o gas.<br /><em>El siguiente paso lo decides tú.</em></h1>
          <p class="hero-description">Te ayudamos a entender lo que pagas y a valorar tus opciones.<br class="desktop-break" /> Empieza con una foto o un PDF. Sin comprometerte a cambiar.</p>
        </div>
        <div class="hero-layout">
          <div class="hero-note" aria-hidden="true"><span>Tal cual la recibes.</span><p>No necesitas descifrarla.<br />De eso nos encargamos.</p><svg viewBox="0 0 140 65" fill="none"><path d="M5 10c28 54 66 31 120 23m-13-8 15 8-12 12" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" /></svg></div>
          <div class="hero-upload">
            <form class="upload-card" id="invoice-form" aria-label="Enviar facturas para revisión">
              <div class="upload-card-top">
                <div class="supply-choice" role="radiogroup" aria-label="Tipo de factura que envías">
                  <span class="file-heading">Tu factura es de</span>
                  <div class="supply-options">
                    <label><input type="radio" name="supply" value="luz" checked /><span><Icon name="bolt" size={12} />Luz</span></label>
                    <label><input type="radio" name="supply" value="gas" /><span><Icon name="flame" size={12} />Gas</span></label>
                    <label><input type="radio" name="supply" value="ambas" /><span>Luz y gas</span></label>
                  </div>
                </div>
              </div>
              <div class="dropzone" id="invoice-dropzone">
                <div class="file-art" aria-hidden="true"><div class="file-back"><span class="art-icon art-back-gas"><Icon name="flame" size={13} /></span></div><div class="file-front"><span class="art-icon art-luz"><Icon name="bolt" size={24} /></span><span class="art-icon art-gas"><Icon name="flame" size={24} /></span><i></i><i></i></div><span class="file-add"><Icon name="plus" size={15} /></span></div>
                <label class="file-label" for="invoice"><span class="file-prompt">Arrastra aquí tus facturas de luz</span><span>o <span class="browse-copy">elige los archivos</span> de tu dispositivo</span><input id="invoice" name="invoice[]" type="file" multiple accept="application/pdf,image/jpeg,image/png" aria-describedby="file-help file-status" /></label>
                <p id="file-help">PDF, JPG o PNG. Hasta 10 archivos, máximo 4&nbsp;MB en total.</p>
              </div>
              <div class="selected-files" id="selected-files" hidden aria-live="polite"></div>
              <p id="file-status" class="file-status" role="status" aria-live="polite"></p>
              <div class="contact-field">
                <div class="contact-head">
                  <label class="contact-label" id="contact-label" for="sender-contact">Déjanos un teléfono</label>
                  <button class="contact-switch" id="contact-switch" type="button">o usa tu email</button>
                </div>
                <input id="sender-contact" name="contact" type="tel" inputmode="tel" autocomplete="tel" spellcheck="false" placeholder="Por ejemplo, 600 123 456" pattern="\+?[0-9][0-9 \-]{7,14}" required />
                <input id="contact-type" name="contact_type" type="hidden" value="phone" />
              </div>
              <div class="comment-field">
                <button class="comment-toggle" id="comment-toggle" type="button" aria-expanded="false" aria-controls="comment-wrap"><Icon name="plus" size={14} />Añadir un comentario <span>opcional</span></button>
                <div class="comment-wrap" id="comment-wrap" hidden><label for="comment">Tu comentario para Wattio</label><textarea id="comment" name="comment" rows="3" maxlength="500" placeholder="Por ejemplo: me interesa revisar la potencia contratada."></textarea></div>
              </div>
              <label class="hp-field" aria-hidden="true">Empresa<input name="company" type="text" tabindex="-1" autocomplete="off" /></label>
              <div class="privacy-consent">
                <label for="privacy"><input id="privacy" name="privacy" type="checkbox" required /><span class="privacy-text">He leído y acepto la política de privacidad de Wattio.</span></label>
                <a href="/privacidad">Leer política</a>
              </div>
              <button class="send-invoice" id="send-invoice" type="submit"><span>Enviar factura a Wattio</span><Icon name="arrow" size={19} /></button>
              <p id="submit-status" class="file-status" role="status" aria-live="polite"></p>
              <div class="local-notice"><Icon name="shield" size={16} /><p>Solo se envían los archivos cuando pulsas «Enviar».</p></div>
              <noscript><p class="file-status">Activa JavaScript para enviar la factura o utiliza WhatsApp. No se enviará ningún archivo automáticamente.</p></noscript>
              <div class="submission-success" id="submission-success" tabindex="-1" hidden><span class="success-mark"><Icon name="check" size={28} /></span><h3>Factura recibida.</h3><p>Hemos enviado tus archivos para revisión. Gracias por confiar en Wattio.</p><a href="#entender">Descubre qué revisamos<Icon name="arrow" size={17} /></a></div>
            </form>
            <div class="whatsapp-option">
              <span>¿Prefieres hacerlo por chat?</span>
              <a class="whatsapp-cta" href={whatsappUrl} target="_blank" rel="noopener noreferrer" aria-describedby="whatsapp-help"><Icon name="whatsapp" size={19} />Enviar por WhatsApp</a>
              <p id="whatsapp-help" class="whatsapp-note">Adjunta la foto o el PDF dentro del chat. El archivo seleccionado aquí no se transfiere a WhatsApp.</p>
            </div>
          </div>
          <aside class="hero-journey" aria-label="De tu factura a una decisión clara">
            <div class="journey-art" aria-hidden="true"><div class="journey-sheet-back"><span class="art-icon art-back-gas"><Icon name="flame" size={14} /></span></div><div class="journey-sheet"><span class="art-icon art-luz"><Icon name="bolt" size={22} /></span><span class="art-icon art-gas"><Icon name="flame" size={22} /></span><i></i><i></i><i></i></div><div class="journey-result"><Icon name="check" size={25} /><span>Todo, más claro.</span><i></i><i></i></div></div>
            <ol class="journey-list"><li><span>1</span><div><strong>Envía tu factura</strong><p>Una foto o un PDF.</p></div></li><li><span>2</span><div><strong>Entiende tus opciones</strong><p>Sin perderte en la letra pequeña.</p></div></li><li><span>3</span><div><strong>Decide con calma</strong><p>La última palabra es tuya.</p></div></li></ol>
          </aside>
        </div>
        <a class="hero-scroll" href="#entender">¿Qué miramos en tu factura?<span><Icon name="arrow" size={17} /></span></a>
      </section>

      <section class="how-section" id="como-funciona" aria-labelledby="how-heading">
        <div class="container">
          <div class="section-intro"><span class="section-index">Cómo funciona</span><p>No necesitas ser experto.<br />Solo tener tu factura a mano.</p></div>
          <h2 id="how-heading">La luz es complicada.<br />Revisarla no debería serlo.</h2>
          <div class="process">
            <svg class="process-line" viewBox="0 0 1120 120" preserveAspectRatio="none" aria-hidden="true"><path d="M20 55H290Q325 55 345 82T402 55H682Q715 55 736 28T793 55H1100" fill="none" stroke="currentColor" stroke-width="1.5" /></svg>
            {steps.map(step => <article class="process-step"><div class="step-visual"><span class="step-symbol"><Icon name={step.icon} size={29} /></span><span class="step-number">{step.number}</span></div><h3>{step.title}</h3><p>{step.text}</p></article>)}
          </div>
          <div class="principle"><span class="principle-symbol"><Icon name="shield" size={25} /></span><p>Una revisión no es un compromiso.<br /><strong>Entender primero. Decidir después.</strong></p><a href="#faq">Resuelve tus dudas<Icon name="arrow" size={18} /></a></div>
        </div>
      </section>

      <section class="explain-section container" id="entender" aria-labelledby="explain-heading">
        <div class="explain-copy">
          <span class="section-index">Más allá del importe final</span>
          <h2 id="explain-heading">Tu factura habla.<br />Vamos a traducirla.</h2>
          <p>Consumo en kWh, potencia contratada en kW, servicios adicionales… Cada concepto cuenta una parte de lo que pagas.</p>
          <p>Explora este ejemplo de luz para entender qué miramos. Con la factura de gas seguimos el mismo criterio.</p>
          <p class="guide-link">¿Quieres el detalle? <a href="/guias/como-leer-tu-factura-de-luz">Cómo leer tu factura de luz</a></p>
          <a class="button primary" href="#revisar">Revisar mi factura<Icon name="arrow" size={20} /></a>
        </div>
        <div class="explain-object"><InvoiceExplorer variant="luz" /></div>
      </section>

      <section class="explain-section gas-section container" id="gas" aria-labelledby="gas-heading">
        <div class="explain-object"><InvoiceExplorer variant="gas" /></div>
        <div class="explain-copy">
          <span class="section-index">La otra factura de casa</span>
          <h2 id="gas-heading">El gas habla distinto.<br />También lo traducimos.</h2>
          <p>Término fijo, consumo en kWh, peajes… La factura de gas tiene conceptos propios y también merece una lectura clara.</p>
          <p>Si nos envías las dos —luz y gas— las revisamos juntas para que veas el conjunto de lo que pagas en energía.</p>
          <p class="guide-link">¿Quieres el detalle? <a href="/guias/como-leer-tu-factura-de-gas">Cómo leer tu factura de gas</a></p>
          <a class="button primary" href="#revisar" data-select-supply="gas">Revisar mi factura de gas<Icon name="arrow" size={20} /></a>
        </div>
      </section>

      <section class="faq container" id="faq" aria-labelledby="faq-heading">
        <div class="faq-intro"><span class="section-index">Antes de empezar</span><h2 id="faq-heading">Todo claro.<br />Desde el principio.</h2><p>También lo que Wattio puede<br />y no puede hacer.</p></div>
        <div class="faq-list">{faqs.map((faq, index) => <details name="questions"><summary><span class="faq-number">{String(index + 1).padStart(2, '0')}</span><span>{faq.question}</span><span class="faq-plus"><Icon name="plus" size={20} /></span></summary><p>{faq.answer}</p></details>)}</div>
      </section>
    </main>

    <footer class="footer container">
      <div class="footer-top"><p>La energía, sin tanto misterio.</p><a href="#top">Volver al inicio<Icon name="arrow" size={18} /></a></div>
      <div class="footer-signature" aria-hidden="true"><Icon name="bolt" size={180} /><span translate="no">wattio</span></div>
      <div class="footer-bottom"><span>© {new Date().getFullYear()} Wattio</span><a class="footer-whatsapp" href={whatsappUrl} target="_blank" rel="noopener noreferrer"><Icon name="whatsapp" size={17} />WhatsApp: +34 646 58 30 77</a><a href="#revisar">Enviar mi factura</a><a href="/guias/">Guías</a><a href="/privacidad">Privacidad</a><a href="/aviso-legal">Aviso legal</a></div>
    </footer>
  </body>
</html>

<script>
  const toggle = document.querySelector<HTMLButtonElement>('.menu-toggle')!;
  const mobileNav = document.querySelector<HTMLElement>('#mobile-navigation')!;
  function closeMenu() {
    mobileNav.hidden = true;
    toggle.setAttribute('aria-expanded', 'false');
  }
  toggle.addEventListener('click', () => {
    const isOpen = toggle.getAttribute('aria-expanded') === 'true';
    mobileNav.hidden = isOpen;
    toggle.setAttribute('aria-expanded', String(!isOpen));
  });
  mobileNav.querySelectorAll('a').forEach(link => link.addEventListener('click', closeMenu));
  document.addEventListener('keydown', event => {
    if (event.key === 'Escape' && !mobileNav.hidden) { closeMenu(); toggle.focus(); }
  });
  document.addEventListener('click', event => {
    if (!mobileNav.hidden && event.target instanceof Node && !mobileNav.contains(event.target) && !toggle.contains(event.target)) closeMenu();
  });
  matchMedia('(min-width: 761px)').addEventListener('change', event => { if (event.matches) closeMenu(); });

  const MAX_TOTAL_SIZE = 4 * 1024 * 1024;
  const MAX_FILES = 10;
  const input = document.querySelector<HTMLInputElement>('#invoice')!;
  const dropzone = document.querySelector<HTMLElement>('.dropzone')!;
  const selected = document.querySelector<HTMLElement>('#selected-files')!;
  const status = document.querySelector<HTMLElement>('#file-status')!;
  const form = document.querySelector<HTMLFormElement>('#invoice-form')!;
  const contactInput = document.querySelector<HTMLInputElement>('#sender-contact')!;
  const contactLabel = document.querySelector<HTMLElement>('#contact-label')!;
  const contactSwitch = document.querySelector<HTMLButtonElement>('#contact-switch')!;
  const contactType = document.querySelector<HTMLInputElement>('#contact-type')!;
  const contactModes: Record<string, { label: string; switchText: string; type: string; autocomplete: string; inputmode: string; placeholder: string; pattern: string | null }> = {
    phone: { label: 'Déjanos un teléfono', switchText: 'o usa tu email', type: 'tel', autocomplete: 'tel', inputmode: 'tel', placeholder: 'Por ejemplo, 600 123 456', pattern: '\\+?[0-9][0-9 \\-]{7,14}' },
    email: { label: 'Déjanos tu email', switchText: 'o usa tu teléfono', type: 'email', autocomplete: 'email', inputmode: 'email', placeholder: 'Por ejemplo, tu@email.com', pattern: null },
  };
  const sendButton = document.querySelector<HTMLButtonElement>('#send-invoice')!;
  const submitStatus = document.querySelector<HTMLElement>('#submit-status')!;
  const success = document.querySelector<HTMLElement>('#submission-success')!;
  const filePrompt = document.querySelector<HTMLElement>('.file-prompt')!;
  const supplyPrompts: Record<string, string> = { luz: 'Arrastra aquí tus facturas de luz', gas: 'Arrastra aquí tus facturas de gas', ambas: 'Arrastra aquí tus facturas de luz y gas' };
  const hero = document.querySelector<HTMLElement>('.hero')!;
  form.querySelectorAll<HTMLInputElement>('input[name="supply"]').forEach(radio => radio.addEventListener('change', () => {
    hero.dataset.supply = radio.value;
    filePrompt.textContent = supplyPrompts[radio.value] ?? supplyPrompts.luz;
  }));
  document.querySelectorAll<HTMLElement>('[data-select-supply]').forEach(link => link.addEventListener('click', () => {
    const radio = form.querySelector<HTMLInputElement>(`input[name="supply"][value="${link.dataset.selectSupply}"]`);
    if (radio) {
      radio.checked = true;
      radio.dispatchEvent(new Event('change', { bubbles: true }));
    }
  }));
  contactSwitch.addEventListener('click', () => {
    const mode = contactModes[contactType.value === 'phone' ? 'email' : 'phone'];
    contactType.value = contactType.value === 'phone' ? 'email' : 'phone';
    contactLabel.textContent = mode.label;
    contactSwitch.textContent = mode.switchText;
    contactInput.type = mode.type;
    contactInput.setAttribute('autocomplete', mode.autocomplete);
    contactInput.setAttribute('inputmode', mode.inputmode);
    contactInput.placeholder = mode.placeholder;
    if (mode.pattern) contactInput.setAttribute('pattern', mode.pattern); else contactInput.removeAttribute('pattern');
  });
  const commentToggle = document.querySelector<HTMLButtonElement>('#comment-toggle')!;
  const commentWrap = document.querySelector<HTMLElement>('#comment-wrap')!;
  const commentArea = document.querySelector<HTMLTextAreaElement>('#comment')!;
  commentToggle.addEventListener('click', () => {
    const opening = commentWrap.hidden;
    commentWrap.hidden = !opening;
    commentToggle.setAttribute('aria-expanded', String(opening));
    if (opening) commentArea.focus();
  });
  let selectedFiles: File[] = [];
  const allowed: Record<string, RegExp> = { 'application/pdf': /\.pdf$/i, 'image/jpeg': /\.jpe?g$/i, 'image/png': /\.png$/i };
  const formatSize = (bytes: number) => new Intl.NumberFormat('es', { maximumFractionDigits: 1 }).format(bytes / 1024) + ' KB';
  function syncInput() {
    const dataTransfer = new DataTransfer();
    selectedFiles.forEach(file => dataTransfer.items.add(file));
    input.files = dataTransfer.files;
  }
  function renderFiles() {
    selected.innerHTML = '';
    selected.hidden = selectedFiles.length === 0;
    selectedFiles.forEach((file, index) => {
      const item = document.createElement('div');
      item.className = 'selected-file';
      item.innerHTML = `<span class="selected-file-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M14 3H6a1 1 0 0 0-1 1v16a1 1 0 0 0 1 1h12a1 1 0 0 0 1-1V9l-6-6Zm0 0v6h6" /></svg></span><div><strong></strong><span>${formatSize(file.size)}</span></div><button type="button" data-remove-file="${index}" aria-label="Quitar ${file.name}"><svg viewBox="0 0 24 24"><path d="m6 6 12 12M6 18 18 6" /></svg></button>`;
      item.querySelector('strong')!.textContent = file.name;
      selected.append(item);
    });
    const total = selectedFiles.reduce((sum, file) => sum + file.size, 0);
    status.dataset.error = 'false';
    input.removeAttribute('aria-invalid');
    status.textContent = selectedFiles.length ? `${selectedFiles.length} archivo${selectedFiles.length === 1 ? '' : 's'} seleccionado${selectedFiles.length === 1 ? '' : 's'} · ${formatSize(total)} de 4 MB.` : 'Puedes elegir varias facturas de una vez.';
  }
  function addFiles(files: File[]) {
    const combined = [...selectedFiles, ...files];
    const duplicateSafe = combined.filter((file, index, all) => all.findIndex(item => item.name === file.name && item.size === file.size && item.lastModified === file.lastModified) === index);
    const invalid = duplicateSafe.find(file => !allowed[file.type]?.test(file.name) || file.size === 0);
    const total = duplicateSafe.reduce((sum, file) => sum + file.size, 0);
    const error = duplicateSafe.length > MAX_FILES ? `Puedes seleccionar hasta ${MAX_FILES} archivos.` : invalid ? `${invalid.name} no es un PDF, JPG o PNG válido o está vacío.` : total > MAX_TOTAL_SIZE ? 'El tamaño total supera los 4 MB. Retira algún archivo para continuar.' : '';
    if (error) {
      status.dataset.error = 'true';
      status.textContent = error;
      input.setAttribute('aria-invalid', 'true');
      return;
    }
    selectedFiles = duplicateSafe;
    syncInput();
    renderFiles();
  }
  input.addEventListener('change', () => addFiles(Array.from(input.files ?? [])));
  selected.addEventListener('click', event => {
    const button = (event.target as HTMLElement).closest<HTMLButtonElement>('[data-remove-file]');
    if (!button) return;
    selectedFiles.splice(Number(button.dataset.removeFile), 1);
    syncInput();
    renderFiles();
    input.focus({ preventScroll: true });
  });
  form.addEventListener('submit', async event => {
    event.preventDefault();
    if (!selectedFiles.length) {
      status.dataset.error = 'true';
      status.textContent = 'Selecciona al menos una factura antes de enviarla.';
      input.focus({ preventScroll: true });
      return;
    }
    if (!contactInput.checkValidity()) {
      contactInput.reportValidity();
      return;
    }
    const sendLabel = sendButton.querySelector('span')!;
    sendButton.disabled = true;
    sendLabel.textContent = 'Enviando…';
    submitStatus.textContent = '';
    submitStatus.dataset.error = 'false';
    try {
      const response = await fetch('/api/submit-invoice', { method: 'POST', body: new FormData(form) });
      const result = await response.json() as { ok?: boolean; error?: string };
      if (!response.ok || !result.ok) throw new Error(result.error ?? 'No se pudo enviar la factura.');
      form.classList.add('is-submitted');
      success.hidden = false;
      success.focus();
    } catch (error) {
      sendButton.disabled = false;
      sendLabel.textContent = 'Enviar factura a Wattio';
      submitStatus.dataset.error = 'true';
      submitStatus.textContent = error instanceof Error ? error.message : 'No se pudo enviar la factura. Inténtalo de nuevo.';
    }
  });
  let dragDepth = 0;
  dropzone.addEventListener('dragenter', event => { event.preventDefault(); dragDepth++; dropzone.classList.add('is-dragging'); });
  dropzone.addEventListener('dragover', event => event.preventDefault());
  dropzone.addEventListener('dragleave', () => { if (--dragDepth <= 0) { dragDepth = 0; dropzone.classList.remove('is-dragging'); } });
  dropzone.addEventListener('drop', event => {
    event.preventDefault();
    dragDepth = 0;
    dropzone.classList.remove('is-dragging');
    addFiles(Array.from(event.dataTransfer?.files ?? []));
  });
</script>
